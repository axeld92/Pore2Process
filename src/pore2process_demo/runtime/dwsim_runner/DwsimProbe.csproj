<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Pore2ProcessRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)', 'pyproject.toml'))</Pore2ProcessRoot>
    <DwsimDir Condition="'$(DwsimDir)' == ''">$(Pore2ProcessRoot)/.local/compatibility/dwsim</DwsimDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(DwsimDir)/DWSIM*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
